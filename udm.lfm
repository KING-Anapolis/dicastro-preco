  object qryFornecedor: TZQuery
    Connection = zCon
    SQL.Strings = (
      'SELECT'
      '  P.prd_fornecedor,'
      '  F.pes_rsocial_nome'
      'FROM TB_PRODUTO P'
      'INNER JOIN TB_PESSOA F ON F.pes_id = P.prd_fornecedor'
      'WHERE F.pes_status = ''A'''
      'GROUP BY 1,2'
      'ORDER BY 2'
    )
    Params = <>
    Left = 47
    Top = 160
