  object qryProdutos: TZQuery
    Connection = zCon
    ReadOnly = True
    SQL.Strings = (
      'SELECT'
      '    p.prd_id,'
      '    p.prd_descricao,'
      '    p.prd_un_venda,'
      '    p.prd_preco_custo,'
      '    p.prd_preco_venda,'
      '    (SELECT * '
      '       FROM sp_produto_estoque(1, p.prd_id, CURRENT_DATE)'
      '    ) AS estoque,'
      '    p.prd_grupo,'
      '    g.pgru_descricao,'
      '    p.prd_subgrupo,'
      '    sg.psgr_descricao,'
      '    p.prd_marca,'
      '    m.pmar_descricao,'
      '    p.prd_setor,'
      '    s.set_descricao,'
      '    p.prd_fornecedor,'
      '    f.pes_rsocial_nome'
      'FROM tb_produto p'
      ''
      'LEFT JOIN tb_prod_grupo g'
      '       ON g.pgru_id = p.prd_grupo'
      ''
      'LEFT JOIN tb_prod_sub_grupo sg'
      '       ON sg.psgr_id = p.prd_subgrupo'
      ''
      'LEFT JOIN tb_prod_marca m'
      '       ON m.pmar_id = p.prd_marca'
      ''
      'LEFT JOIN tb_setor s'
      '       ON s.set_id = p.prd_setor'
      ''
      'LEFT JOIN tb_pessoa f'
      '       ON f.pes_id = p.prd_fornecedor'
      ''
      'WHERE p.prd_tipo_produto = ''N'''
      ''
      'AND ('
      '    :STATUS = ''T'''
      '    OR p.prd_status = :STATUS'
      ')'
      ''
      'AND ('
      '    COALESCE(NULLIF(:PRODUTO, ''''), ''0'') IN (''0'', ''-1'')'
      '    OR p.prd_id = :PRODUTO'
      ')'
    )
    Params = <    
      item
        Name = 'STATUS'
      end    
      item
        Name = 'PRODUTO'
      end>
    Left = 200
    Top = 30
    ParamData = <    
      item
        Name = 'STATUS'
      end    
      item
        Name = 'PRODUTO'
      end>
