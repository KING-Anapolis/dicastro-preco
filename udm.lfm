  object qryCompras: TZQuery
    Connection = zCon
    SQL.Strings = (
      'SELECT FIRST :LIMITE *'
      'FROM'
      '('
      '    SELECT'
      '      '''' AS DEVOLUCAO,'
      '      ''NOTA FISCAL'' AS ORIGEM,'
      '      N.nf_numero AS NUMERO,'
      '      N.nf_dt_emissao AS EMISSAO,'
      '      F.pes_rsocial_nome AS FORNECEDOR,'
      '      I.nfi_qtde_estoque AS QTD,'
      '      p.PRD_UN_VENDA AS UN,'
      '      I.NFI_VALOR_SUB_TOTAL / I.nfi_qtde_estoque AS VR_UN,'
      '      I.nfi_valor_desconto AS DESCONTO,'
      '      I.nfi_valor_total AS TOTAL'
      '    FROM tb_nota_fiscal_item I'
      '    LEFT JOIN TB_NOTA_FISCAL N ON N.nf_id = I.nfi_nota_fiscal'
      '    LEFT JOIN TB_PESSOA F ON F.pes_id = N.nf_pessoa'
      '    LEFT JOIN TB_PRODUTO P ON P.PRD_ID = i.NFI_PRODUTO'
      '    WHERE N.nf_status = ''N'''
      '      AND I.nfi_produto = :PRODUTO'
      '      and n.nf_pedido_compra is null'
      ''
      '    UNION ALL'
      ''
      '    SELECT'
      '      '''' AS DEVOLUCAO,'
      '      ''PED. COMPRA'' AS ORIGEM,'
      '      C.pdc_id AS NUMERO,'
      '      C.pdc_dt_recebimento AS EMISSAO,'
      '      F.pes_rsocial_nome AS FORNECEDOR,'
      '      IC.pdci_qtde_recebida AS QTD,'
      '      IC.pdci_unidade AS UN,'
      '      IC.pdci_valor_unitario AS VR_UN,'
      '      IC.pdci_desconto AS DESCONTO,'
      '      IC.pdci_valor_recebido AS TOTAL'
      '    FROM tb_pedido_compra_item IC'
      '    LEFT JOIN tb_pedido_compra C ON C.pdc_id = IC.pdci_pedido_compra'
      '    LEFT JOIN TB_PESSOA F ON F.pes_id = C.pdc_fornecedor'
      '    WHERE C.pdc_status = ''R'''
      '      AND IC.pdci_produto = :PRODUTO'
      '      and c.pdc_nota_fiscal is null'
      ''
      '    UNION ALL'
      ''
      '    SELECT'
      '      ''X'' AS DEVOLUCAO,'
      '      ''TROCA/DEV'' AS ORIGEM,'
      '      DV.dev_id AS NUMERO,'
      '      DV.dev_dt_emissao AS EMISSAO,'
      '      F.pes_rsocial_nome AS FORNECEDOR,'
      '      DVI.devi_quantidade AS QTD,'
      '      DVI.devi_un_venda AS UN,'
      '      DVI.devi_valor_unitario AS VR_UN,'
      '      0.00 AS DESCONTO,'
      '      DVI.devi_valor_total AS TOTAL'
      '    FROM tb_devolucao_item DVI'
      '    LEFT JOIN tb_devolucao DV ON DV.dev_id = DVI.devi_devolucao'
      '    LEFT JOIN tb_pessoa F ON F.pes_id = DV.dev_cliente'
      '    WHERE DV.dev_tipo = ''V'''
      '    AND DVI.devi_produto = :PRODUTO'
      ''
      '    UNION ALL'
      ''
      '    SELECT'
      '      ''O'' AS DEVOLUCAO,'
      '      ''OUTRAS/MOV'' AS ORIGEM,'
      '      OM.omp_id AS NUMERO,'
      '      OM.omp_dt_emissao AS EMISSAO,'
      '      COALESCE('
      '        NULLIF(TRIM(F.PES_RSOCIAL_NOME), ''''),'
      '        NULLIF(TRIM(OM.OMP_OBSERVACAO), ''''),'
      '        NULLIF(TRIM(OMI.OMPI_OBSERVACAO), '''')'
      '      ) AS FORNECEDOR,'
      '      OMI.ompi_quantidade AS QTD,'
      '      OMI.ompi_unidade AS UN,'
      '      OMI.ompi_valor_unitario AS VR_UN,'
      '      0.00 AS DESCONTO,'
      '      OMI.ompi_valor_total AS TOTAL'
      '    FROM tb_outras_mov_item OMI'
      '    LEFT JOIN tb_outras_mov OM ON OM.omp_id = OMI.ompi_outras_mov'
      '    LEFT JOIN tb_pessoa F ON F.pes_id = OM.omp_pessoa'
      '    WHERE OMI.ompi_tipo_mov = ''E'''
      '    AND OMI.ompi_produto = :PRODUTO'
      ''
      ') X'
      'ORDER BY X.EMISSAO DESC'
    )
    Params = <    
      item
        Name = 'LIMITE'
      end    
      item
        Name = 'PRODUTO'
      end>
    Left = 272
    Top = 32
    ParamData = <    
      item
        Name = 'LIMITE'
      end    
      item
        Name = 'PRODUTO'
      end>
