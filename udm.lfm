  object qryVendas: TZQuery
    Connection = zCon
    SQL.Strings = (
      'SELECT FIRST :LIMITE'
      '      ''VENDA'' AS ORIGEM,'
      '      V.pev_id AS NUMERO,'
      '      V.pev_dt_faturamento AS EMISSAO,'
      '      c.pes_rsocial_nome AS VENDEDOR,'
      '      CL.pes_rsocial_nome || ''('' || CL.pes_fantasia_apelido || '')'' AS CLIENTE,'
      '      I.pevi_quantidade AS QTD,'
      '      I.pevi_un_venda AS UN,'
      '      I.pevi_valor_unitario AS VR_UN,'
      '      I.pevi_valor_desconto AS DESCONTO,'
      '      I.pevi_valor_total AS TOTAL,'
      '      CAST(CASE WHEN COALESCE(P.PRD_PRECO_CUSTO, 0) > 0'
      '        THEN ((I.pevi_valor_unitario - P.PRD_PRECO_CUSTO) / P.PRD_PRECO_CUSTO) * 100'
      '        ELSE NULL END AS NUMERIC(15,6)) AS MARKUP'
      '    FROM TB_PEDIDO_VENDA_ITEM I'
      '    LEFT JOIN TB_PRODUTO P ON P.PRD_ID = I.pevi_produto'
      '    LEFT JOIN TB_PEDIDO_VENDA V ON V.pev_id = I.pevi_pedido_venda'
      '    LEFT JOIN TB_PESSOA C on c.pes_id = v.pev_vendedor'
      '    LEFT JOIN TB_PESSOA CL ON CL.pes_id = V.pev_cliente'
      '    WHERE V.pev_status = ''F'''
      '    and i.pevi_produto = :produto'
      '    ORDER BY 3 DESC'
    )
    Params = <    
      item
        Name = 'LIMITE'
      end    
      item
        Name = 'PRODUTO'
      end>
    Left = 352
    Top = 32
    ParamData = <    
      item
        Name = 'LIMITE'
      end    
      item
        Name = 'PRODUTO'
      end>
