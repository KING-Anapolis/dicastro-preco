  object qryProdutosComprar: TZQuery
    Connection = data.zCon
    SQL.Strings = (
      ''
      '-- Soma as quantidades dos itens de pedidos faturados no período.'
      'WITH VENDAS AS ('
      '    SELECT'
      '        I.PEVI_PRODUTO AS PRD_ID,'
      '        SUM(I.PEVI_QUANTIDADE) AS VENDIDO'
      '    FROM TB_PEDIDO_VENDA V'
      '    INNER JOIN TB_PEDIDO_VENDA_ITEM I'
      '        ON I.PEVI_PEDIDO_VENDA = V.PEV_ID'
      '    WHERE'
      '        V.PEV_STATUS = ''F'''
      '        AND V.PEV_DT_FATURAMENTO >= :DT_INICIAL'
      '        AND V.PEV_DT_FATURAMENTO <'
      '            DATEADD(1 DAY TO :DT_FINAL)'
      '    GROUP BY'
      '        I.PEVI_PRODUTO'
      '),'
      '-- Soma o estoque de todos os locais da empresa 1 por produto.'
      'ESTOQUE AS ('
      '    SELECT'
      '        E.PRDE_PRODUTO AS PRD_ID,'
      '        SUM(E.PRDE_ESTOQUE) AS ESTOQUE'
      '    FROM TB_PRODUTO_ESTOQUE E'
      '    WHERE E.PRDE_EMPRESA = 1'
      '    GROUP BY E.PRDE_PRODUTO'
      ')'
      '-- Retorna cada produto uma vez; vendas e estoque já estão agregados.'
      'SELECT'
      '    P.PRD_ID,'
      '    P.PRD_DESCRICAO,'
      '    P.PRD_UN_VENDA,'
      '    M.PMAR_DESCRICAO,'
      '    COALESCE(V.VENDIDO, 0) AS VENDIDO,'
      '    COALESCE(E.ESTOQUE, 0) AS ESTOQUE,'
      '-- Comprar é a diferença positiva entre vendido e estoque.'
      '    CASE'
      '        WHEN COALESCE(V.VENDIDO, 0) > COALESCE(E.ESTOQUE, 0)'
      '        THEN COALESCE(V.VENDIDO, 0) - COALESCE(E.ESTOQUE, 0)'
      '        ELSE 0'
      '    END AS COMPRAR'
      'FROM TB_PRODUTO P'
      'LEFT JOIN TB_PROD_MARCA M'
      '    ON M.PMAR_ID = P.PRD_MARCA'
      'LEFT JOIN VENDAS V'
      '    ON V.PRD_ID = P.PRD_ID'
      'LEFT JOIN ESTOQUE E'
      '    ON E.PRD_ID = P.PRD_ID'
      '-- Parâmetros opcionais restringem o cadastro pelos filtros informados.'
      '-- PRODUTOS_ZERO=1 mostra todos; =0 mostra apenas vendidos acima do estoque.'
      'WHERE'
      '    (CAST(:DESC AS VARCHAR(255)) IS NULL'
      '        OR P.PRD_DESCRICAO STARTING WITH :DESC)'
      '    AND (CAST(:FOR AS INTEGER) IS NULL'
      '        OR P.PRD_FORNECEDOR = :FOR)'
      '    AND (CAST(:GRU AS INTEGER) IS NULL'
      '        OR P.PRD_GRUPO = :GRU)'
      '    AND (CAST(:MAR AS INTEGER) IS NULL'
      '        OR P.PRD_MARCA = :MAR)'
      '    AND (CAST(:SUBG AS INTEGER) IS NULL'
      '        OR P.PRD_SUBGRUPO = :SUBG)'
      '    AND (CAST(:SET AS INTEGER) IS NULL'
      '        OR P.PRD_SETOR = :SET)'
      '    AND ('
      '    (:PRODUTOS_ZERO = 1)'
      '    OR (:PRODUTOS_ZERO = 0'
      '        AND COALESCE(V.VENDIDO, 0) > COALESCE(E.ESTOQUE, 0))'
      '    )'
      'ORDER BY'
      '    P.PRD_DESCRICAO;'
    )
    Params = <    
      item
        Name = 'DT_INICIAL'
      end    
      item
        Name = 'DT_FINAL'
      end    
      item
        Name = 'DESC'
      end    
      item
        Name = 'FOR'
      end    
      item
        Name = 'GRU'
      end    
      item
        Name = 'MAR'
      end    
      item
        Name = 'SUBG'
      end    
      item
        Name = 'SET'
      end    
      item
        Name = 'PRODUTOS_ZERO'
      end>
    Left = 1054
    Top = 184
    ParamData = <    
      item
        Name = 'DT_INICIAL'
      end    
      item
        Name = 'DT_FINAL'
      end    
      item
        Name = 'DESC'
      end    
      item
        Name = 'FOR'
      end    
      item
        Name = 'GRU'
      end    
      item
        Name = 'MAR'
      end    
      item
        Name = 'SUBG'
      end    
      item
        Name = 'SET'
      end    
      item
        Name = 'PRODUTOS_ZERO'
      end>
